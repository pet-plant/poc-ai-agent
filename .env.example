OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
CONFIDENCE_THRESHOLD=0.5
DEFAULT_SPECIES=Monstera deliciosa
SQLITE_DB_PATH=:memory:

# LangChain Provider & Vector Store Configuration
LLM_PROVIDER=ollama
# Options: ollama | openai | anthropic | gemini | mock
LLM_MODEL=
# e.g., gpt-4o-mini, claude-3-5-sonnet-20241022, gemini-2.0-flash

VECTOR_STORE_MODE=memory
# Options: memory | pgvector
POSTGRES_URL=postgresql+psycopg://postgres:postgres@localhost:5432/plant_poc
